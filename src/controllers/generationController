const express = require('express');
const { spawn } = require('child_process');
const app = express();
const port = 3000;


function generateMazeHandler(req, res) {
    
    console.log('Serveur Express: Requête reçue ! Lancement du générateur Python...');

    // 1. LANCER LE SCRIPT PYTHON
    const pythonProcess = spawn('python', ['maze_generator.py']);

    // Variables pour stocker la réponse de Python
    let pythonData = '';
    let pythonError = '';

    // 2. ÉCOUTER LES DONNÉES (stdout)
    pythonProcess.stdout.on('data', (data) => {
        console.log('Serveur Express: Python a envoyé des données...');
        pythonData += data.toString();
    });

    // 3. ÉCOUTER LES ERREURS (stderr)
    pythonProcess.stderr.on('data', (data) => {
        console.error('Serveur Express: Python a envoyé une ERREUR...');
        

        if (data.toString().includes("Script Python:")) {
             console.log(data.toString());
        } else {
             pythonError += data.toString();
        }
    });

    // 4. QUAND LE PROCESSUS SE TERMINE
    pythonProcess.on('close', (code) => {
        console.log(`Serveur Express: Python a terminé avec le code ${code}`);

        if (pythonError) {
            return res.status(500).json({ 
                error: "Erreur lors de l'exécution du script Python",
                details: pythonError 
            });
        }
        
        // Si tout va bien, on renvoie le paquet JSON reçu de Python
        try {
            res.status(200).json(JSON.parse(pythonData));
        } catch (e) {
            res.status(500).json({ 
                error: "Impossible de parser la réponse JSON de Python",
                details: pythonData 
            });
        }
    });
}