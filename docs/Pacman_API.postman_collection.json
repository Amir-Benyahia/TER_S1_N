{
  "info": {
    "name": "Pacman AI Simulation API",
    "description": "Complete API collection for Pacman AI simulation endpoints",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "mazeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "simulationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "batchId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Simulations",
      "item": [
        {
          "name": "Run New Simulation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minimax vs Blinky Test\",\n  \"mazeId\": \"{{mazeId}}\",\n  \"pacmanAlgorithm\": \"minimax\",\n  \"pacmanConfig\": {\n    \"depth\": 4,\n    \"iterations\": 1000,\n    \"startPos\": { \"x\": 1, \"y\": 1 }\n  },\n  \"ghostConfigs\": [\n    {\n      \"type\": \"blinky\",\n      \"algorithm\": \"astar\",\n      \"startPosition\": { \"x\": 10, \"y\": 10 }\n    }\n  ],\n  \"results\": {\n    \"caught\": false,\n    \"catchPosition\": null,\n    \"catchTime\": null,\n    \"duration\": 45.2,\n    \"score\": 2400,\n    \"pelletsCollected\": 120,\n    \"totalFrames\": 1356,\n    \"frames\": [],\n    \"performance\": {\n      \"pacman\": {\n        \"decisionTime\": { \"mean\": 12.5, \"max\": 45.2, \"min\": 2.1 },\n        \"memoryUsage\": { \"mean\": 2048, \"max\": 3072, \"min\": 1024 },\n        \"complexity\": \"O(b^d)\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/simulations",
              "host": ["{{baseUrl}}"],
              "path": ["simulations"]
            },
            "description": "Run a new simulation with Pacman AI and Ghost configurations"
          }
        },
        {
          "name": "Get All Simulations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/simulations?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["simulations"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "mazeId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "trajectoryId",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Get paginated list of all simulations"
          }
        },
        {
          "name": "Get Simulation by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/simulations/{{simulationId}}?includeFrames=true",
              "host": ["{{baseUrl}}"],
              "path": ["simulations", "{{simulationId}}"],
              "query": [
                {
                  "key": "includeFrames",
                  "value": "true"
                }
              ]
            },
            "description": "Get detailed simulation information"
          }
        },
        {
          "name": "Get Replay Frames",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/simulations/{{simulationId}}/replay",
              "host": ["{{baseUrl}}"],
              "path": ["simulations", "{{simulationId}}", "replay"]
            },
            "description": "Get only replay frames for simulation"
          }
        },
        {
          "name": "Delete Simulation",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/simulations/{{simulationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["simulations", "{{simulationId}}"]
            },
            "description": "Delete a simulation"
          }
        }
      ]
    },
    {
      "name": "Batches",
      "item": [
        {
          "name": "Create Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minimax Performance Test Suite\",\n  \"description\": \"Testing Minimax with depth 3-5 across 10 mazes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches",
              "host": ["{{baseUrl}}"],
              "path": ["batches"]
            },
            "description": "Create a new batch container"
          }
        },
        {
          "name": "Run Batch Simulations (Automation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"MCTS vs A* Ghosts - 100 Iterations\",\n  \"mazeId\": \"{{mazeId}}\",\n  \"pacmanAlgorithm\": \"mcts\",\n  \"pacmanConfig\": {\n    \"depth\": 3,\n    \"iterations\": 2000\n  },\n  \"ghostConfigs\": [\n    {\n      \"type\": \"blinky\",\n      \"algorithm\": \"astar\",\n      \"startPosition\": { \"x\": 10, \"y\": 10 }\n    },\n    {\n      \"type\": \"pinky\",\n      \"algorithm\": \"astar\",\n      \"startPosition\": { \"x\": 15, \"y\": 5 }\n    }\n  ],\n  \"iterations\": 100,\n  \"maxDuration\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/run-batch",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "run-batch"]
            },
            "description": "🔥 PRIMARY AUTOMATION ENDPOINT - Configure and run batch simulations"
          }
        },
        {
          "name": "Get All Batches",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/batches?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["batches"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get paginated list of all batches"
          }
        },
        {
          "name": "Get Batch by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "{{batchId}}"]
            },
            "description": "Get batch with simulations and aggregate statistics"
          }
        },
        {
          "name": "Update Batch",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Batch Name\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "{{batchId}}"]
            },
            "description": "Update batch metadata"
          }
        },
        {
          "name": "Delete Batch",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "{{batchId}}"]
            },
            "description": "Delete a batch"
          }
        },
        {
          "name": "Add Simulations to Batch",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"simulationIds\": [\n    \"simulation-id-1\",\n    \"simulation-id-2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/add-simulations",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "{{batchId}}", "add-simulations"]
            },
            "description": "Add existing simulations to batch"
          }
        },
        {
          "name": "Clear Batch",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/batches/{{batchId}}/clear",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "{{batchId}}", "clear"]
            },
            "description": "Remove all simulations from batch"
          }
        }
      ]
    },
    {
      "name": "Mazes",
      "item": [
        {
          "name": "Generate Maze",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Maze 20x20\",\n  \"config\": {\n    \"width\": 20,\n    \"height\": 20,\n    \"wallDensity\": 0.3,\n    \"pelletDensity\": 0.7\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mazes",
              "host": ["{{baseUrl}}"],
              "path": ["mazes"]
            },
            "description": "Generate a new maze"
          }
        },
        {
          "name": "Get All Mazes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mazes?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["mazes"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get paginated list of mazes"
          }
        },
        {
          "name": "Get Maze by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mazes/{{mazeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mazes", "{{mazeId}}"]
            },
            "description": "Get maze details"
          }
        },
        {
          "name": "Delete Maze",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/mazes/{{mazeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mazes", "{{mazeId}}"]
            },
            "description": "Delete a maze"
          }
        }
      ]
    },
    {
      "name": "Example Workflows",
      "item": [
        {
          "name": "1. Test All 8 Algorithms",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"Algorithm Comparison Suite\",\n  \"mazeId\": \"{{mazeId}}\",\n  \"pacmanAlgorithm\": \"greedy\",\n  \"ghostConfigs\": [\n    { \"type\": \"blinky\", \"algorithm\": \"astar\", \"startPosition\": { \"x\": 10, \"y\": 10 } }\n  ],\n  \"iterations\": 10,\n  \"maxDuration\": 60,\n  \"comment\": \"Run this 8 times, changing pacmanAlgorithm each time: greedy, defensive, aggressive, random, minimax, expectimax, influence_map, mcts\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/run-batch",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "run-batch"]
            },
            "description": "Compare all 8 Pacman algorithms"
          }
        },
        {
          "name": "2. Depth Comparison (Minimax)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"Minimax Depth 3-5 Comparison\",\n  \"mazeId\": \"{{mazeId}}\",\n  \"pacmanAlgorithm\": \"minimax\",\n  \"pacmanConfig\": {\n    \"depth\": 3\n  },\n  \"ghostConfigs\": [\n    { \"type\": \"blinky\", \"algorithm\": \"astar\", \"startPosition\": { \"x\": 10, \"y\": 10 } }\n  ],\n  \"iterations\": 20,\n  \"maxDuration\": 60,\n  \"comment\": \"Run 3 times with depth: 3, 4, 5\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/run-batch",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "run-batch"]
            },
            "description": "Test Minimax performance at different depths"
          }
        },
        {
          "name": "3. MCTS Iterations Test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchName\": \"MCTS Iterations Comparison\",\n  \"mazeId\": \"{{mazeId}}\",\n  \"pacmanAlgorithm\": \"mcts\",\n  \"pacmanConfig\": {\n    \"iterations\": 500\n  },\n  \"ghostConfigs\": [\n    { \"type\": \"blinky\", \"algorithm\": \"astar\", \"startPosition\": { \"x\": 10, \"y\": 10 } }\n  ],\n  \"iterations\": 15,\n  \"maxDuration\": 60,\n  \"comment\": \"Test with iterations: 500, 1000, 2000, 5000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/batches/run-batch",
              "host": ["{{baseUrl}}"],
              "path": ["batches", "run-batch"]
            },
            "description": "Compare MCTS performance with different iteration counts"
          }
        }
      ]
    }
  ]
}
